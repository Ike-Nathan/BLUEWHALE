  },
  "devDependencies": {
    "@ladle/react": "4.1.2",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "^18.2.0",
    "jsdom": "24.1.1",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "typescript": "^5.4.5",
    "vitest": "1.6.0"
  }
