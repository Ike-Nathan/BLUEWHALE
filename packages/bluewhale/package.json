{
  "name": "@redishfish/bluewhale",
  "version": "0.1.0",
  "description": "Bluewhale – React UI components (address input, type badge, warnings, memo)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "echo \"no tests\""
  },
  "dependencies": {
    "@redishfish/bluewhale-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.4.5"
  }
}
